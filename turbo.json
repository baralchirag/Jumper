{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "pkg-web/**", "pkg-node/**", "target/release/kicad-core"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@jumper/kicad-core#build"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["@jumper/kicad-core#build"]
    },
    "test": {
      "dependsOn": ["@jumper/kicad-core#build"]
    }
  }
}
