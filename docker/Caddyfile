# Serves the SPA and proxies the API and git smart-HTTP to the api service.
# SITE_ADDRESS is ":80" for plain HTTP, or your domain (jumper.example.com) for automatic HTTPS.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	@api path /api/*
	handle @api {
		reverse_proxy api:3000
	}

	@git path_regexp git ^/[^/]+/[^/]+/(info/refs|git-upload-pack|git-receive-pack)$
	handle @git {
		request_body {
			max_size 512MB
		}
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	# Git LFS: large files go straight to the API, without the git push size cap.
	@lfs path_regexp lfs ^/[^/]+/[^/]+/info/lfs/
	handle @lfs {
		request_body {
			max_size 5GB
		}
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	# Embeddable viewer: the one page other sites may put in an iframe (public repositories only).
	@embed path /embed/*
	handle @embed {
		root * /srv
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors *"
		}
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options DENY
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
			Cross-Origin-Opener-Policy same-origin
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; worker-src 'self' blob:; connect-src 'self' ws: wss:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		}
		try_files {path} /index.html
		file_server
	}
}
