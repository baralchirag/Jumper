{
  "name": "jumper",
  "private": true,
  "description": "GitHub-style collaboration platform for KiCad hardware projects",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "start": "turbo run build && node scripts/start.mjs",
    "start:fast": "node scripts/start.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @jumper/db generate",
    "db:migrate": "pnpm --filter @jumper/db migrate",
    "db:studio": "pnpm --filter @jumper/db studio",
    "wasm": "pnpm --filter @jumper/kicad-core build",
    "services": "node scripts/services.mjs",
    "admin": "tsx --env-file-if-exists=.env apps/api/src/cli/admin.ts",
    "admin:grant": "tsx --env-file-if-exists=.env apps/api/src/cli/admin.ts grant",
    "admin:revoke": "tsx --env-file-if-exists=.env apps/api/src/cli/admin.ts revoke",
    "admin:list": "tsx --env-file-if-exists=.env apps/api/src/cli/admin.ts list"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
