# --- Core ---
NODE_ENV=development
PUBLIC_URL=http://localhost:5173
API_PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# --- Postgres ---
DATABASE_URL=postgres://pcbhub:pcbhub@localhost:5432/pcbhub

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Git storage (shared by api + worker) ---
REPOS_DIR=./data/repos
MAX_PUSH_BYTES=524288000

# --- Object storage: "s3" (MinIO/S3) or "fs" (local dir) ---
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./data/artifacts
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pcbhub
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- GitHub OAuth (optional) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Worker ---
# "docker" runs every kicad-cli call in a locked-down container,
# "none" runs kicad-cli directly (use only inside the hardened worker image).
WORKER_SANDBOX=none
WORKER_KICAD_IMAGE=pcbhub/kicad-worker:latest
WORKER_CONCURRENCY=2
WORKER_JOB_TIMEOUT_MS=600000
KICAD_CLI=kicad-cli
