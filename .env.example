# --- Core ---
NODE_ENV=development
PUBLIC_URL=http://localhost:5173
API_PORT=3000
# Sessions are random tokens stored (hashed) in Postgres; there is no signing secret to configure.

# --- Postgres ---
DATABASE_URL=postgres://pcbhub:pcbhub@localhost:5432/pcbhub

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Git storage (shared by api + worker) ---
REPOS_DIR=./data/repos
MAX_PUSH_BYTES=524288000

# --- Object storage: "s3" (MinIO/S3) or "fs" (local dir) ---
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./data/artifacts
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pcbhub
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- GitHub OAuth (optional) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Worker ---
# "docker" runs every kicad-cli call in a locked-down container,
# "none" runs kicad-cli directly (use only inside the hardened worker image).
WORKER_SANDBOX=none
WORKER_KICAD_IMAGE=jumper/kicad-worker:latest
WORKER_CONCURRENCY=2
# Fast lane for ERC, DRC and BOM (renders and exports use WORKER_CONCURRENCY above).
WORKER_CHECKS_CONCURRENCY=1
WORKER_JOB_TIMEOUT_MS=600000
KICAD_CLI=auto

# --- BOM pricing ---
# LCSC and JLCPCB work without keys. Mouser: https://www.mouser.com/api-hub/
# DigiKey: create an app at https://developer.digikey.com (Product Information v4).
PRICING_ENABLED=true
MOUSER_API_KEY=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# --- Access control ---
# Set to false on private deployments. Nobody is admin by default: after registering,
# run `pnpm admin:grant <username>` on the server.
ALLOW_SIGNUP=true
# Restrict /api/admin to these client IPs (comma-separated). Needs TRUST_PROXY=true behind a reverse proxy.
ADMIN_ALLOWED_IPS=
# Development only: let webhooks call private/loopback addresses. Never enable in production.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# --- Docker deployment (docker/docker-compose.yml requires these) ---
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Public address and TLS (docker deployment) ---
# Plain HTTP on this machine:        SITE_ADDRESS=:80      HTTP_PORT=8080
# Real domain with automatic HTTPS:  SITE_ADDRESS=jumper.example.com   HTTP_PORT=80   HTTPS_PORT=443
#                                    PUBLIC_URL=https://jumper.example.com
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Email (password reset links) ---
# Leave empty to log emails instead of sending; admins can then create reset links in Admin -> Users.
#   SMTP_URL=smtps://user:password@smtp.example.com:465
#   MAIL_FROM=Jumper <noreply@example.com>
SMTP_URL=
MAIL_FROM=

# --- Legal pages (/terms, /privacy, /refunds) ---
# Who runs this instance. Shown in the terms, privacy and refund policies; have them reviewed before taking payments.
OPERATOR_NAME=
OPERATOR_EMAIL=
OPERATOR_JURISDICTION=
LEGAL_UPDATED=

# --- Plans and limits ---
# Turn on for the public service: storage, check minutes and seats are then enforced per plan.
PLANS_ENFORCED=false

# --- Card payments (Stripe) ---
# Both keys switch on card checkout, plan changes and the Stripe customer portal. Without them, plans are assigned
# by an administrator and invoiced. Products and prices are created in Stripe automatically from the plan list.
# Webhook endpoint to add in Stripe: https://<your-domain>/api/stripe/webhook, with the events
#   checkout.session.completed, customer.subscription.created / updated / deleted / paused / resumed,
#   invoice.finalized / paid / payment_failed / voided / marked_uncollectible / updated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Let Stripe Tax add sales tax / VAT at checkout (set up Stripe Tax in the dashboard first).
STRIPE_AUTOMATIC_TAX=false
# Interactive OpenAPI explorer at /api/docs. Leave off in production: it lists every endpoint.
API_DOCS=false
# The Free plan's storage is a trial: 2 GB for this many days from sign-up (or organization creation), then
# FREE_STORAGE_AFTER_TRIAL_MB (0 = pushes that add data need a paid plan; nothing is deleted).
FREE_TRIAL_DAYS=30
FREE_STORAGE_AFTER_TRIAL_MB=0
# Each person who joins through someone's invite link adds REFERRAL_BONUS_MB to that person for REFERRAL_BONUS_DAYS.
REFERRAL_BONUS_MB=1024
REFERRAL_MAX_BONUS_MB=10240
REFERRAL_BONUS_DAYS=15
# Optional JSON overrides of the built-in plans (storage in MB, check minutes per month, seats; null = unlimited):
#   PLAN_LIMITS={"free":{"storageMb":5120,"checkMinutes":1000,"seats":5},"pro":{"seats":null}}
PLAN_LIMITS=

# --- Scheduled jobs: housekeeping, mirrors, weekly digest emails, BOM stock/end-of-life checks ---
SCHEDULER_ENABLED=true
# Security-log entries older than this many days are deleted.
AUDIT_RETENTION_DAYS=365
# Weekly digest (needs SMTP_URL) and daily stock checks for repositories that switch them on (needs pricing).
DIGEST_ENABLED=true
STOCK_ALERTS_ENABLED=true

# --- Fab ordering ---
# "Order from ..." buttons next to fab packages. Set to your referral/partner links; they are marked as referral
# links in the interface. Unset, each goes to the fab's own upload page.
FAB_REFERRAL_JLCPCB=
FAB_REFERRAL_PCBWAY=
FAB_REFERRAL_OSHPARK=

# --- Single sign-on for the whole instance (OpenID Connect) ---
# Organizations add their own OIDC or SAML connections in their settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# `common`, `organizations`, or your tenant id to accept only your own directory.
MICROSOFT_TENANT=common
# End sessions this many hours after sign-in regardless of activity (unset = 30 days, sliding).
SESSION_MAX_HOURS=

# --- Licence (self-hosted Business and Enterprise features) ---
# Paste the key here, put it in LICENSE_FILE, or install it in Admin -> Licence.
LICENSE_KEY=
LICENSE_FILE=./data/license.key
# Defaults to on in production; off in development so every feature can be tried.
# LICENSE_ENFORCED=true

# --- Network ---
# Never contact anything outside your network on its own (no supplier pricing, stock alerts, update check,
# public sign-in providers). Mirrors, imports and webhooks still go where you point them.
AIR_GAPPED=false
# Check once a day whether a newer Jumper exists; nothing about the instance is sent.
UPDATE_CHECK=true

# --- Mirroring and git over SSH ---
# Encrypts stored mirror access tokens. Without it, a random key is written to SECRET_KEY_FILE on first use.
SECRET_KEY=
# Built-in SSH server for git (no shell access). Clone URLs use SSH_PUBLIC_HOST/SSH_PUBLIC_PORT when behind NAT or a proxy.
SSH_ENABLED=false
SSH_PORT=2222
SSH_PUBLIC_HOST=
SSH_PUBLIC_PORT=
# Largest single Git LFS object, in MB.
LFS_MAX_OBJECT_MB=2048
